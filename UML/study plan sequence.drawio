      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n\ntitle StudyFlow AI - Complete Study Session\n\nactor Student\nboundary \&quot;Flutter App\&quot; as App\ncontrol \&quot;StudySessionController\&quot; as Controller\ncontrol \&quot;StudySessionService\&quot; as Service\ndatabase \&quot;PostgreSQL\&quot; as DB\n\nStudent -&gt; App : Tap \&quot;Complete Session\&quot;\n\nactivate App\n\nApp -&gt; Controller : PATCH /api/study-sessions/{id}/complete\n\nactivate Controller\n\nController -&gt; Service : completeSession(sessionId)\n\nactivate Service\n\nService -&gt; DB : Find StudySession by ID\nactivate DB\n\nDB --&gt; Service : StudySession\n\ndeactivate DB\n\nService -&gt; Service : Validate session\n\nService -&gt; Service : Set status = COMPLETED\n\nService -&gt; Service : Set completedAt = now()\n\nService -&gt; Service : Calculate actualMinutes\n\nService -&gt; DB : Update StudySession\nactivate DB\n\nDB --&gt; Service : Updated StudySession\n\ndeactivate DB\n\nService -&gt; DB : Get related Deadline\nactivate DB\n\nDB --&gt; Service : Deadline\n\ndeactivate DB\n\nService -&gt; Service : Update completedMinutes\n\nalt Deadline workload completed\n\n    Service -&gt; Service : Set Deadline status = COMPLETED\n\nelse Deadline still needs study time\n\n    Service -&gt; Service : Set Deadline status = IN_PROGRESS\n\nend\n\nService -&gt; DB : Update Deadline\nactivate DB\n\nDB --&gt; Service : Updated Deadline\n\ndeactivate DB\n\nService --&gt; Controller : Completed session\n\ndeactivate Service\n\nController --&gt; App : 200 OK + Updated Session\n\ndeactivate Controller\n\nApp --&gt; Student : Show completion confirmation\\nand updated progress\n\ndeactivate App\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="ScdTWE8a7w1WkjKcIP3C-276">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
